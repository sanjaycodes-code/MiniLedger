# Production environment variables for MiniLedger Web / Mobile (Vercel / Expo)
# NOTE: EXPO_PUBLIC_* variables are baked into the JavaScript bundle at build time (`npx expo export --platform web`).
# Changing them in Vercel requires triggering a new deployment.

EXPO_PUBLIC_API_URL=https://miniledger-api.onrender.com/api/v1
EXPO_PUBLIC_DEMO_MODE=true
