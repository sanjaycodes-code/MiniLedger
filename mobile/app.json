{
  "expo": {
    "name": "MiniLedger",
    "slug": "MiniLedger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1220",
    "splash": {
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0B1220"
    },
    "android": {
      "backgroundColor": "#0B1220",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "backgroundColor": "#0B1220",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#0B1220",
      "barStyle": "light-content"
    },
    "web": {
      "name": "MiniLedger",
      "shortName": "MiniLedger",
      "description": "Track money lent to friends in INR with due dates, repayment tracking, and receipt photos.",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0B1220",
      "themeColor": "#0B1220"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MiniLedger to access your photo library to attach loan receipts.",
          "cameraPermission": "Allow MiniLedger to use your camera to take photos of loan receipts."
        }
      ],
      "expo-font"
    ]
  }
}
