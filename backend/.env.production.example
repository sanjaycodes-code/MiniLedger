# Production environment variables for MiniLedger Backend (Render + Neon Postgres)

# Pooled Neon PostgreSQL connection string (must include ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Secret for signing 7-day HS256 JWTs (REQUIRED: at least 32 random characters in production)
JWT_SECRET="replace-with-at-least-32-cryptographically-random-characters"

# Port bound by the HTTP server (Render injects PORT automatically)
PORT=4000

# Runtime environment ("production" enforces 32+ char JWT_SECRET and strict CORS_ORIGINS)
NODE_ENV=production

# Comma-separated allow-list of frontend origins (no trailing slashes, no "*", no localhost in production)
CORS_ORIGINS="https://miniledger.vercel.app"

# Demo login mode for public visitors (fixed OTP, no 30s per-phone cooldown, no 5-attempt lockout on DEMO_PHONE)
DEMO_MODE=true
DEMO_PHONE="+919999999999"
DEMO_OTP="123456"

# Directory for receipt uploads (ephemeral on free Render; use /var/data/uploads if attaching a paid Render Disk)
UPLOAD_DIR=uploads
